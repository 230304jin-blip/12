# ==== Claude 反代配置示例 ====
# 复制为 .env 并按需修改 (Node 版本请用: `export $(cat .env | xargs)` 或进程管理器注入)

# 监听端口 / 地址
PORT=8787
HOST=0.0.0.0

# 上游 Anthropic API 地址 (可指向自建/其它兼容网关)
ANTHROPIC_BASE_URL=https://api.anthropic.com

# 服务器持有的上游密钥。配置后客户端无需再传自己的 key。
# 留空则要求客户端在请求头自带 x-api-key / Authorization。
ANTHROPIC_API_KEY=

# 客户端访问本代理所需的密钥 (逗号分隔可配置多个)。
# 留空则不校验访问权限 (仅在需要客户端自带上游 key 时安全)。
ACCESS_KEY=

# Anthropic 接口版本
ANTHROPIC_VERSION=2023-06-01

# OpenAI 兼容接口未显式指定时的默认 max_tokens
DEFAULT_MAX_TOKENS=4096
